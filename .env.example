# Root-level env example — each sub-package has its own .env.example

# ── AI Agent ──────────────────────────────────────────────
# GEMINI_API_KEY=           # Google Gemini API key
# BACKEND_URL=http://localhost:3002   # exposes the agreed /api/guardian/verify contract

# ── Guardian ──────────────────────────────────────────────
# GUARDIAN_PORT=3001
# BACKEND_URL=http://localhost:3002
# AUDIT_LOG_PATH=./guardian-audit.log

# ── Backend ───────────────────────────────────────────────
# BACKEND_PORT=3002
# DATABASE_URL=file:./dev.db
# PLATFORM_PRIVATE_KEY=     # hex-encoded 32-byte Ed25519 private key (leave blank to auto-generate)
# DISPATCHER_API_KEY=safegate-dispatcher-key-change-me
# CORS_ORIGIN=http://localhost:3000
# GUARDIAN_URL=http://localhost:3001    # used by POST /api/guardian/verify

# ── Frontend ──────────────────────────────────────────────
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3002
# NEXT_PUBLIC_GUARDIAN_URL=http://localhost:3001
# NEXT_PUBLIC_DISPATCHER_API_KEY=  # must match backend DISPATCHER_API_KEY
