# AI Agent
LLM_API_KEY=

# PostgreSQL connection string
# If unset, the Agent runs in local (in-memory) mode with no external services.
DATABASE_URL=postgres://safegate:safegate@localhost:5432/safegate

# Redis connection string (anti-brute-force attempt limiting)
REDIS_URL=redis://localhost:6379

# Auth security
JWT_SECRET=dev-secret-change-me

# Server port
PORT=4100

# Base URL of the SafeGate Backend (Guardian + Tools API)
SAFEGATE_BACKEND_URL=http://localhost:4000

# optional bearer token for backend calls
SAFEGATE_BACKEND_TOKEN=

# Agent identity / platform DID for verification calls
LINKED_USERS=
